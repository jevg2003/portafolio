---
import { Terminal } from '@lucide/astro';
---

<header id="main-header" class="fixed top-6 left-0 right-0 z-50 px-4 md:px-8 max-w-7xl mx-auto will-change-transform">
  <nav class="w-full glass-panel glass-panel-glow px-6 py-4 rounded-2xl flex items-center justify-between border-white/5 shadow-2xl relative overflow-hidden">
    <!-- Background glow sweep -->
    <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/5 via-transparent to-neon-pink/5 pointer-events-none"></div>

    <!-- Logo / Identity -->
    <a href="#inicio" class="flex items-center gap-2 group relative z-10 font-mono font-bold text-lg text-white tracking-wider">
      <div class="p-2 rounded-lg bg-white/5 border border-white/10 group-hover:border-neon-cyan/50 group-hover:bg-neon-cyan/5 transition-all duration-300">
        <Terminal class="w-5 h-5 text-neon-cyan group-hover:text-white transition-colors duration-300" />
      </div>
      <span class="relative overflow-hidden inline-block h-6">
        <span class="inline-block transition-transform duration-300 group-hover:-translate-y-full">DEV.PORTFOLIO</span>
        <span class="absolute left-0 top-full inline-block text-neon-cyan transition-transform duration-300 group-hover:-translate-y-full">CREATIVE.DEV</span>
      </span>
    </a>

    <!-- Nav Links (Desktop) -->
    <div class="hidden md:flex items-center gap-8 relative z-10 font-mono text-sm">
      <a href="#inicio" class="nav-link text-text-secondary hover:text-white transition-colors py-1 relative group">
        Inicio
        <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-neon-cyan group-hover:w-full transition-all duration-300 shadow-[0_0_8px_#f4c420]"></span>
      </a>
      <a href="#proyectos" class="nav-link text-text-secondary hover:text-white transition-colors py-1 relative group">
        Proyectos
        <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-neon-pink group-hover:w-full transition-all duration-300 shadow-[0_0_8px_#ff9900]"></span>
      </a>
      <a href="#habilidades" class="nav-link text-text-secondary hover:text-white transition-colors py-1 relative group">
        Habilidades
        <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-neon-violet group-hover:w-full transition-all duration-300 shadow-[0_0_8px_#ffe9a8]"></span>
      </a>
      <a href="#contacto" class="nav-link text-text-secondary hover:text-white transition-colors py-1 relative group">
        Contacto
        <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-neon-cyan group-hover:w-full transition-all duration-300 shadow-[0_0_8px_#f4c420]"></span>
      </a>
    </div>

    <!-- Socials / CTAs (Desktop) -->
    <div class="hidden md:flex items-center gap-4 relative z-10">
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" 
         class="p-2 rounded-xl bg-white/5 border border-white/10 text-text-secondary hover:text-neon-cyan hover:border-neon-cyan/30 hover:bg-neon-cyan/5 transition-all duration-300 magnetic-hover"
         aria-label="GitHub Profile">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </svg>
      </a>
      <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" 
         class="p-2 rounded-xl bg-white/5 border border-white/10 text-text-secondary hover:text-neon-pink hover:border-neon-pink/30 hover:bg-neon-pink/5 transition-all duration-300 magnetic-hover"
         aria-label="LinkedIn Profile">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
          <rect x="2" y="9" width="4" height="12" />
          <circle cx="4" cy="4" r="2" />
        </svg>
      </a>
      <a href="#contacto" 
         class="px-4 py-2 rounded-xl bg-gradient-to-r from-neon-cyan/20 to-neon-violet/20 border border-neon-cyan/30 text-white font-mono text-xs hover:border-neon-cyan hover:from-neon-cyan/30 hover:to-neon-violet/30 transition-all duration-300 shadow-[0_0_15px_rgba(244,196,32,0.1)] hover:shadow-[0_0_20px_rgba(244,196,32,0.25)]">
        Construyamos algo
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden p-2 rounded-xl bg-white/5 border border-white/10 text-text-secondary hover:text-white transition-colors" aria-label="Toggle Menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="fixed inset-x-4 top-28 glass-panel glass-panel-glow border-white/5 rounded-2xl p-6 shadow-2xl flex flex-col gap-6 scale-95 opacity-0 pointer-events-none transition-all duration-300 md:hidden origin-top">
    <div class="flex flex-col gap-4 font-mono text-base">
      <a href="#inicio" class="mobile-link text-text-secondary hover:text-neon-cyan transition-colors py-2 border-b border-white/5">/inicio</a>
      <a href="#proyectos" class="mobile-link text-text-secondary hover:text-neon-pink transition-colors py-2 border-b border-white/5">/proyectos</a>
      <a href="#habilidades" class="mobile-link text-text-secondary hover:text-neon-violet transition-colors py-2 border-b border-white/5">/habilidades</a>
      <a href="#contacto" class="mobile-link text-text-secondary hover:text-neon-cyan transition-colors py-2 border-b border-white/5">/contacto</a>
    </div>
    <div class="flex items-center gap-4 justify-between pt-2 border-t border-white/5">
      <div class="flex items-center gap-3">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-white/5 text-text-secondary hover:text-neon-cyan transition-colors" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
        </a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-white/5 text-text-secondary hover:text-neon-pink transition-colors" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
            <rect x="2" y="9" width="4" height="12" />
            <circle cx="4" cy="4" r="2" />
          </svg>
        </a>
      </div>
      <a href="#contacto" class="px-4 py-2 rounded-lg bg-neon-cyan/20 border border-neon-cyan/30 text-white font-mono text-xs">
        Contratar
      </a>
    </div>
  </div>
</header>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let headerTrigger: ScrollTrigger | null = null;
  let outsideClickListener: ((e: MouseEvent) => void) | null = null;

  function closeDrawer(drawer: HTMLElement) {
    drawer.classList.remove('scale-100', 'opacity-100', 'pointer-events-auto');
    drawer.classList.add('scale-95', 'opacity-0', 'pointer-events-none');
  }

  function setupNavbar() {
    const header = document.getElementById('main-header');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    // Scroll effect (hide on scroll down, show on scroll up).
    // A single ScrollTrigger replaces the raw scroll listener: it batches into
    // one tick and only ever animates `transform`, which stays on the compositor.
    if (header) {
      headerTrigger?.kill();

      headerTrigger = ScrollTrigger.create({
        start: 0,
        end: 'max',
        onUpdate: (self) => {
          if (self.scroll() > 100) {
            header.classList.add('shadow-2xl');
            // direction 1 = scrolling down, -1 = scrolling up
            gsap.to(header, {
              yPercent: self.direction === 1 ? -150 : 0,
              duration: 0.3,
              ease: 'power2.out',
              overwrite: 'auto',
            });
          } else {
            header.classList.remove('shadow-2xl');
            gsap.to(header, { yPercent: 0, duration: 0.3, ease: 'power2.out', overwrite: 'auto' });
          }
        },
      });
    }

    // Mobile drawer toggle
    if (menuBtn && drawer) {
      menuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = drawer.classList.contains('scale-100');
        if (isOpen) {
          closeDrawer(drawer);
        } else {
          drawer.classList.remove('scale-95', 'opacity-0', 'pointer-events-none');
          drawer.classList.add('scale-100', 'opacity-100', 'pointer-events-auto');
        }
      });

      // Close drawer when clicking a link
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => closeDrawer(drawer));
      });

      // Close drawer on click outside. `setupNavbar` re-runs on every
      // `astro:page-load`, so drop the previous document-level listener first
      // instead of stacking a new one on each route change.
      if (outsideClickListener) {
        document.removeEventListener('click', outsideClickListener);
      }
      outsideClickListener = (e: MouseEvent) => {
        if (!drawer.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
          closeDrawer(drawer);
        }
      };
      document.addEventListener('click', outsideClickListener);
    }
  }

  // Hook to astro page load events
  document.addEventListener('astro:page-load', setupNavbar);

  document.addEventListener('astro:before-swap', () => {
    headerTrigger?.kill();
    headerTrigger = null;
    if (outsideClickListener) {
      document.removeEventListener('click', outsideClickListener);
      outsideClickListener = null;
    }
  });
</script>
