---
---
<canvas id="interactive-canvas" transition:persist="canvas" class="fixed inset-0 -z-10 w-full h-full pointer-events-none bg-transparent opacity-40"></canvas>

<script>
  let animationId = 0;
  let cleanupCanvas: (() => void) | null = null;
  let canvasInitialized = false;

  // High-DPI screens can otherwise ask for a 3x backing store, which triples the
  // pixels rasterized every frame for no perceptible gain on a soft particle field.
  const MAX_DPR = 1.5;

  function initCanvas() {
    const canvas = document.getElementById('interactive-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    // Prevent double initialization when canvas is persisted across page routes
    if (canvasInitialized) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    canvasInitialized = true;

    // Cancel existing loop if running
    if (animationId) {
      cancelAnimationFrame(animationId);
      animationId = 0;
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // CSS pixel dimensions; the backing store is scaled by a capped DPR.
    let width = window.innerWidth;
    let height = window.innerHeight;

    function sizeCanvas() {
      if (!ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      // Draw in CSS pixels; the context handles the device-pixel scale.
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    sizeCanvas();

    // Mouse coordinates and velocity tracking
    const mouse = { x: -9999, y: -9999, active: false, radius: 150 };

    // Generate particles (optimized density to improve CPU/GPU load)
    const particleCount = Math.min(45, Math.floor((width * height) / 25000));
    const particles: Array<{
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      color: string;
      originalRadius: number;
      angle: number;
      speed: number;
    }> = [];

    const colors = [
      'rgba(244, 196, 32, ',  // signal
      'rgba(255, 153, 0, ',   // ember
      'rgba(255, 233, 168, ' // pale
    ];

    for (let i = 0; i < particleCount; i++) {
      const radius = Math.random() * 2 + 1;
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
        radius: radius,
        originalRadius: radius,
        color: colors[Math.floor(Math.random() * colors.length)],
        angle: Math.random() * Math.PI * 2,
        speed: 0.01 + Math.random() * 0.02
      });
    }

    // Resize handler — debounced, since a drag-resize fires it continuously and
    // reallocating the backing store is expensive.
    let resizeTimeout = 0;
    const resizeListener = () => {
      window.clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(sizeCanvas, 150);
    };
    window.addEventListener('resize', resizeListener);

    // Mouse movement
    const mouseListener = (e: MouseEvent) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.active = true;
    };
    window.addEventListener('mousemove', mouseListener);

    // Touch support
    const touchListener = (e: TouchEvent) => {
      if (e.touches.length > 0) {
        mouse.x = e.touches[0].clientX;
        mouse.y = e.touches[0].clientY;
        mouse.active = true;
      }
    };
    window.addEventListener('touchmove', touchListener, { passive: true });

    // Mouse leave
    const mouseLeaveListener = () => {
      mouse.x = -9999;
      mouse.y = -9999;
      mouse.active = false;
    };
    window.addEventListener('mouseleave', mouseLeaveListener);

    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, width, height);

      // Draw and update particles
      particles.forEach((p) => {
        // Move particle
        p.x += p.vx;
        p.y += p.vy;

        // Add subtle floating drift
        p.angle += p.speed;
        p.x += Math.sin(p.angle) * 0.1;
        p.y += Math.cos(p.angle) * 0.1;

        // Bounce off walls
        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        // Mouse repulsion effect (velocity change when close)
        if (mouse.active) {
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const distance = Math.hypot(dx, dy);

          if (distance < mouse.radius) {
            const force = (mouse.radius - distance) / mouse.radius;
            // Push away
            p.x += (dx / distance) * force * 1.5;
            p.y += (dy / distance) * force * 1.5;
            
            // Expand slightly on focus
            p.radius = p.originalRadius * (1 + force * 1.5);
          } else {
            // Return to original size
            if (p.radius > p.originalRadius) {
              p.radius -= 0.1;
            }
          }
        } else {
          if (p.radius > p.originalRadius) {
            p.radius -= 0.1;
          }
        }

        // Draw particle (no shadowBlur: it forces a full-canvas blur pass per particle, per frame)
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = p.color + '0.8)';
        ctx.fill();
      });

      // Connect particles. The link pass is O(n^2); on narrow viewports the
      // links are barely visible, so skip it entirely there. `width` is the
      // cached CSS width, so this costs no per-frame DOM read.
      if (width >= 768) {
        for (let i = 0; i < particles.length; i++) {
          const p1 = particles[i];
          for (let j = i + 1; j < particles.length; j++) {
            const p2 = particles[j];
            const dx = p1.x - p2.x;
            const dy = p1.y - p2.y;
            const dist = Math.hypot(dx, dy);
            const maxDist = 120;

            if (dist < maxDist) {
              let opacity = (maxDist - dist) / maxDist;

              // Enhance line opacity if mouse is near the link
              if (mouse.active) {
                const mouseDist1 = Math.hypot(p1.x - mouse.x, p1.y - mouse.y);
                const mouseDist2 = Math.hypot(p2.x - mouse.x, p2.y - mouse.y);
                if (mouseDist1 < mouse.radius || mouseDist2 < mouse.radius) {
                  opacity *= 1.8;
                }
              }

              ctx.beginPath();
              ctx.moveTo(p1.x, p1.y);
              ctx.lineTo(p2.x, p2.y);

              // Render a flat color stroke based on source particle, avoiding costly gradient allocation
              ctx.strokeStyle = p1.color + opacity * 0.12 + ')';
              ctx.lineWidth = 0.5;
              ctx.stroke();
            }
          }
        }
      }

      animationId = requestAnimationFrame(draw);
    }

    // Single entry point for (re)starting the loop. Cancelling any pending frame
    // first makes it impossible to end up with two concurrent rAF chains.
    function startLoop() {
      if (reduceMotion) return;
      if (animationId) cancelAnimationFrame(animationId);
      animationId = requestAnimationFrame(draw);
    }

    function stopLoop() {
      if (animationId) {
        cancelAnimationFrame(animationId);
        animationId = 0;
      }
    }

    // Under reduced motion, paint a single static frame and never animate.
    if (reduceMotion) {
      draw();
      stopLoop();
    }

    // The canvas is full-screen and fixed, so it is visible unless the tab is
    // hidden or the element itself is detached/offscreen. The observer covers
    // the second case; `visibilitychange` covers the first.
    let isVisible = true;
    let isTabVisible = !document.hidden;

    const syncLoop = () => {
      if (isVisible && isTabVisible) {
        startLoop();
      } else {
        stopLoop();
      }
    };

    const visibilityObserver = new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting;
      syncLoop();
    });
    visibilityObserver.observe(canvas);

    // Pause the loop while the tab is hidden — no point animating an invisible canvas
    const visibilityListener = () => {
      isTabVisible = !document.hidden;
      syncLoop();
    };
    document.addEventListener('visibilitychange', visibilityListener);

    syncLoop();

    cleanupCanvas = () => {
      stopLoop();
      window.clearTimeout(resizeTimeout);
      window.removeEventListener('resize', resizeListener);
      window.removeEventListener('mousemove', mouseListener);
      window.removeEventListener('touchmove', touchListener);
      window.removeEventListener('mouseleave', mouseLeaveListener);
      document.removeEventListener('visibilitychange', visibilityListener);
      visibilityObserver.disconnect();
      canvasInitialized = false;
      cleanupCanvas = null;
    };
  }

  // Handle Astro page transitions (ClientRouter)
  document.addEventListener('astro:page-load', initCanvas);

  document.addEventListener('astro:before-swap', () => {
    cleanupCanvas?.();
  });
</script>
