---
---

<div class="scroll-progress-container">
  <!-- Glowing vertical line -->
  <svg class="w-full h-full" viewBox="0 0 10 100" preserveAspectRatio="none">
    <!-- Unfilled background line -->
    <path 
      d="M 5 0 L 5 100" 
      fill="none" 
      stroke="rgba(255, 255, 255, 0.05)" 
      stroke-width="1.5"
    />
    <!-- Filled animated line -->
    <path 
      id="scroll-drawn-path" 
      d="M 5 0 L 5 100" 
      fill="none" 
      stroke="url(#scroll-grad)" 
      stroke-width="2"
      stroke-linecap="round"
    />
    <defs>
      <linearGradient id="scroll-grad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#f4c420" />
        <stop offset="50%" stop-color="#ff9900" />
        <stop offset="100%" stop-color="#ffe9a8" />
      </linearGradient>
    </defs>
  </svg>

  <!-- Interactive Nodes representing sections -->
  <div class="absolute left-1/2 -translate-x-1/2 flex flex-col justify-between h-[80vh] top-[10vh]">
    <div data-section="inicio" class="pointer-events-auto cursor-pointer scroll-node active group relative">
      <div class="w-4 h-4 rounded-full border-2 border-white/10 bg-bg-dark group-hover:border-neon-cyan transition-all duration-300 flex items-center justify-center shadow-lg">
        <div class="w-1.5 h-1.5 rounded-full bg-neon-cyan scale-0 group-[.active]:scale-100 transition-all duration-300"></div>
      </div>
      <span class="absolute left-6 top-1/2 -translate-y-1/2 font-mono text-[9px] tracking-wider text-text-muted group-[.active]:text-neon-cyan uppercase opacity-50 group-hover:opacity-100 group-[.active]:opacity-100 transition-all duration-300 origin-left">Inicio</span>
    </div>
    
    <div data-section="proyectos" class="pointer-events-auto cursor-pointer scroll-node group relative">
      <div class="w-4 h-4 rounded-full border-2 border-white/10 bg-bg-dark group-hover:border-neon-pink transition-all duration-300 flex items-center justify-center shadow-lg">
        <div class="w-1.5 h-1.5 rounded-full bg-neon-pink scale-0 group-[.active]:scale-100 transition-all duration-300"></div>
      </div>
      <span class="absolute left-6 top-1/2 -translate-y-1/2 font-mono text-[9px] tracking-wider text-text-muted group-[.active]:text-neon-pink uppercase opacity-50 group-hover:opacity-100 group-[.active]:opacity-100 transition-all duration-300 origin-left">Proyectos</span>
    </div>

    <div data-section="habilidades" class="pointer-events-auto cursor-pointer scroll-node group relative">
      <div class="w-4 h-4 rounded-full border-2 border-white/10 bg-bg-dark group-hover:border-neon-violet transition-all duration-300 flex items-center justify-center shadow-lg">
        <div class="w-1.5 h-1.5 rounded-full bg-neon-violet scale-0 group-[.active]:scale-100 transition-all duration-300"></div>
      </div>
      <span class="absolute left-6 top-1/2 -translate-y-1/2 font-mono text-[9px] tracking-wider text-text-muted group-[.active]:text-neon-violet uppercase opacity-50 group-hover:opacity-100 group-[.active]:opacity-100 transition-all duration-300 origin-left">Habilidades</span>
    </div>

    <div data-section="contacto" class="pointer-events-auto cursor-pointer scroll-node group relative">
      <div class="w-4 h-4 rounded-full border-2 border-white/10 bg-bg-dark group-hover:border-neon-cyan transition-all duration-300 flex items-center justify-center shadow-lg">
        <div class="w-1.5 h-1.5 rounded-full bg-neon-cyan scale-0 group-[.active]:scale-100 transition-all duration-300"></div>
      </div>
      <span class="absolute left-6 top-1/2 -translate-y-1/2 font-mono text-[9px] tracking-wider text-text-muted group-[.active]:text-neon-cyan uppercase opacity-50 group-hover:opacity-100 group-[.active]:opacity-100 transition-all duration-300 origin-left">Contacto</span>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const SECTIONS = ['inicio', 'proyectos', 'habilidades', 'contacto'] as const;

  function initScrollLine() {
    const path = document.getElementById('scroll-drawn-path') as SVGPathElement | null;
    const nodes = Array.from(document.querySelectorAll<HTMLElement>('.scroll-node'));

    if (!path) return null;

    // Get total length of path
    const pathLength = path.getTotalLength();

    // Set up path dash styles to hide it initially
    path.style.strokeDasharray = `${pathLength}`;
    path.style.strokeDashoffset = `${pathLength}`;

    // ScrollTriggers created here, so cleanup can kill exactly these and
    // leave triggers owned by other components untouched.
    const triggers: ScrollTrigger[] = [];

    // Progress line: the line must reach each node exactly when its section
    // is reached, not fill linearly against total document height — nodes are
    // spaced by flexbox, not by how much scroll content each section holds.
    // So the fill is piecewise: one segment per gap between consecutive nodes,
    // each mapped to that section's own scroll range.
    const svgEl = path.ownerSVGElement;

    function nodePathLengths() {
      if (!svgEl) return nodes.map(() => 0);
      const svgRect = svgEl.getBoundingClientRect();
      if (svgRect.height === 0) return nodes.map(() => 0);
      return nodes.map((node) => {
        const r = node.getBoundingClientRect();
        const fraction = (r.top + r.height / 2 - svgRect.top) / svgRect.height;
        return Math.min(1, Math.max(0, fraction)) * pathLength;
      });
    }

    // Pixel scroll position where each section's top reaches the top of the
    // viewport — the breakpoint at which the line should be fully lit up to
    // that section's node.
    const sectionTriggers = SECTIONS.map((id) => {
      const section = document.getElementById(id);
      return section ? ScrollTrigger.create({ trigger: section, start: 'top top' }) : null;
    });
    sectionTriggers.forEach((t) => t && triggers.push(t));

    let nodeLengths = nodePathLengths();

    function currentPathLength() {
      const scrollY = window.scrollY;
      const breakpoints = sectionTriggers.map((t) => (t ? t.start : 0));

      for (let i = 0; i < breakpoints.length - 1; i++) {
        const segStart = breakpoints[i];
        const segEnd = breakpoints[i + 1];
        if (scrollY < segEnd || i === breakpoints.length - 2) {
          const segFraction =
            segEnd > segStart ? Math.min(1, Math.max(0, (scrollY - segStart) / (segEnd - segStart))) : 1;
          return nodeLengths[i] + segFraction * (nodeLengths[i + 1] - nodeLengths[i]);
        }
      }
      return nodeLengths[0] ?? 0;
    }

    const progressTrigger = ScrollTrigger.create({
      trigger: document.documentElement,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: () => {
        path.style.strokeDashoffset = `${pathLength - currentPathLength()}`;
      },
      onRefresh: () => {
        nodeLengths = nodePathLengths();
        path.style.strokeDashoffset = `${pathLength - currentPathLength()}`;
      },
    });
    triggers.push(progressTrigger);

    // Active-section detection: one ScrollTrigger per section. ScrollTrigger
    // caches each section's layout values and batches every update into a
    // single tick, which removes the per-scroll-event getBoundingClientRect().
    const setActive = (id: string) => {
      nodes.forEach((node) => {
        node.classList.toggle('active', node.getAttribute('data-section') === id);
      });
    };

    SECTIONS.forEach((id) => {
      const section = document.getElementById(id);
      if (!section) return;

      triggers.push(
        ScrollTrigger.create({
          trigger: section,
          // Matches the previous rule: a section becomes active once its top
          // crosses the middle of the viewport.
          start: 'top 50%',
          end: 'bottom 50%',
          onEnter: () => setActive(id),
          onEnterBack: () => setActive(id),
        })
      );
    });

    // Make nodes clickable to scroll to sections
    const onNodeClick = (event: Event) => {
      const node = event.currentTarget as HTMLElement;
      const targetId = node.getAttribute('data-section');
      const targetEl = document.getElementById(targetId || '');
      if (!targetEl) return;

      const lenis = (window as any).__lenis;
      if (lenis) {
        lenis.scrollTo(targetEl);
      } else {
        targetEl.scrollIntoView({ behavior: 'smooth' });
      }
    };

    nodes.forEach((node) => node.addEventListener('click', onNodeClick));

    ScrollTrigger.refresh();

    // Return cleanup function to destroy on transition
    return () => {
      nodes.forEach((node) => node.removeEventListener('click', onNodeClick));
      triggers.forEach((trigger) => trigger.kill());
      triggers.length = 0;
    };
  }

  // Hook to page transitions
  let cleanup: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    if (cleanup) cleanup();
    cleanup = initScrollLine();
  });

  document.addEventListener('astro:before-swap', () => {
    if (cleanup) cleanup();
    cleanup = null;
  });
</script>
